# ── Inventory (same Supabase project as bb-inventory) ──────────────────────
# Server-only: these are NOT prefixed with NEXT_PUBLIC_ on purpose, so the key
# never reaches shoppers' browsers. (The inventory tables allow writes with the
# anon key, so it must stay secret on a public site.)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional, preferred if you have it (Supabase -> Project Settings -> API):
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (optional) ────────────────────────────────────────────────────
# Leave blank and the cart sends an order request by email instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flat shipping in cents (e.g. 500 = $5.00). Blank = no shipping charge.
SHIPPING_FLAT_CENTS=500
# Orders at or above this many dollars ship free. Blank = never free.
FREE_SHIPPING_MIN=75
# Offer a free "Local pickup" option at checkout.
LOCAL_PICKUP=true

# ── Shop contact info (shown on the site) ──────────────────────────────────
CONTACT_EMAIL=
INSTAGRAM_URL=
SITE_URL=http://localhost:3001

# ── Bearded Bear Packs (virtual packs) ─────────────────────────────────────
# REQUIRED for packs: the service role key (Supabase -> Project Settings -> API).
# Pack tables are locked to everyone else. Never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=   (set above)
# Comma-separated emails that can use /admin/packs
ADMIN_EMAILS=
# Buyback % is set by card value in /admin/packs (default 75% under $20 up to 95% at $500+).
# Any random string; protects the daily TCGplayer price sync (Vercel Cron sends it automatically)
CRON_SECRET=
# Flat fee (cents) taken from balance when a player ships vault cards home
VAULT_SHIP_FEE_CENTS=500
