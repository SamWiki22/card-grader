# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by checkout + the Stripe webhook to create/fulfill orders. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site, used for Stripe success/cancel redirects (e.g. https://shop.example.com)
SITE_URL=

# Optional: Stripe card payments. Without these, checkout records an order as "pending payment"
# and you collect payment yourself (invoice / in-store pickup), then mark it paid in /admin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Limitless TCG API key (https://play.limitlesstcg.com/account/settings/api).
# Public tournament/standings endpoints work without it, at a lower rate limit.
LIMITLESS_API_KEY=

# Branding / mounting inside an existing site
NEXT_PUBLIC_SHOP_NAME=Illestcollect
# Serve under a path of your main site (e.g. /shop). Leave blank for its own domain or subdomain.
NEXT_PUBLIC_BASE_PATH=
# Which games are live on the storefront. Blank = the defaults in lib/games.js
# (One Piece, Gundam, Dragon Ball Fusion World, Union Arena, Riftbound). Add mtg when you're ready:
# NEXT_PUBLIC_LIVE_GAMES=onepiece,gundam,dragonball,unionarena,riftbound,mtg
NEXT_PUBLIC_LIVE_GAMES=
